; Launcher gry: osobny, maly projekt. Nazwa jest taka sama jak w grze,
; bo oba korzystaja z tego samego folderu user://.

config_version=5

[application]

config/name="Giera"
config/description="Pobiera aktualizacje i uruchamia gre"
run/main_scene="res://launcher.tscn"
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/app_icon.png"

[display]

window/size/viewport_width=520
window/size/viewport_height=260
window/size/resizable=false
window/stretch/mode="canvas_items"

[giera]

; Wersja silnika i bibliotek w tym launcherze. CI wpisuje tu wartosc z make_manifest.py.
runtime_id="dev"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
