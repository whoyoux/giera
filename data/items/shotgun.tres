[gd_resource type="Resource" script_class="WeaponDefinition" format=3]

[ext_resource type="Script" path="res://scripts/items/weapon_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/items/weapon_stats.gd" id="2_stats"]
